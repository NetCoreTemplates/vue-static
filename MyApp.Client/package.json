{
  "name": "vite-static",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dtos": "npx get-dtos ts",
    "build": "vue-tsc -b && vp build",
    "preview": "vp preview",
    "check": "vp check && vue-tsc -b",
    "typecheck": "vue-tsc -b",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test",
    "test:run": "vp test run",
    "test:ui": "vp test --ui",
    "outdated": "vp outdated",
    "upgrade": "npx npm-check-updates@latest -u --reject vite,vite-plus,@vitest/ui,typescript,vue-router && npm install"
  },
  "dependencies": {
    "@servicestack/client": "^2.1.13",
    "@servicestack/vue": "^3.1.11",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/ui": "5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
